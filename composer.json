{
    "name": "oden7777/custom-global-variables",
    "description": "Development dependencies for the Custom Global Variables WordPress plugin.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^1.1",
        "squizlabs/php_codesniffer": "^3.13",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "compat": "phpcs -p --standard=PHPCompatibilityWP --runtime-set testVersion 5.6- custom-global-variables.php"
    }
}
